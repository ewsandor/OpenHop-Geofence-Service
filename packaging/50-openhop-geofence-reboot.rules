// Example polkit rule allowing the openhop-geofence service account to reboot
// the host through systemd-logind. Not installed automatically.
//
// Install only if you also set maintenance.allow_reboot = true:
//   sudo install -m 0644 50-openhop-geofence-reboot.rules /etc/polkit-1/rules.d/
//
// The rule grants only an ordinary reboot. Shutdown inhibitors are still
// honored (org.freedesktop.login1.reboot-ignore-inhibit is not granted).
polkit.addRule(function (action, subject) {
    if (subject.user == "openhop-geofence" &&
        (action.id == "org.freedesktop.login1.reboot" ||
         action.id == "org.freedesktop.login1.reboot-multiple-sessions")) {
        return polkit.Result.YES;
    }
});
